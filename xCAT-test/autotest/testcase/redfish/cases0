start:redfish_rpower_off_on
description:rpower off and on through a Redfish BMC; rpower stat confirms each new state
Attribute: $$CN-a node with mgt=redfish and a row in the openbmc table
label:cn_bmc_ready,hctrl_redfish
hcp:redfish
cmd:rpower $$CN off
check:rc==0
check:output=~$$CN: off
cmd:rpower $$CN stat
check:rc==0
check:output=~$$CN: off
cmd:rpower $$CN on
check:rc==0
check:output=~$$CN: on
cmd:rpower $$CN stat
check:rc==0
check:output=~$$CN: on
end

start:redfish_rpower_boot
description:rpower boot powers on a node that is off; rpower state confirms it
Attribute: $$CN-a node with mgt=redfish and a row in the openbmc table
label:cn_bmc_ready,hctrl_redfish
hcp:redfish
cmd:rpower $$CN off
check:rc==0
cmd:rpower $$CN state
check:output=~$$CN: off
cmd:rpower $$CN boot
check:rc==0
check:output=~$$CN: boot
cmd:rpower $$CN state
check:rc==0
check:output=~$$CN: on
end

start:redfish_rpower_reset
description:rpower reset restarts a node that is on and leaves a node that is off off
Attribute: $$CN-a node with mgt=redfish and a row in the openbmc table
label:cn_bmc_ready,hctrl_redfish
hcp:redfish
cmd:rpower $$CN on
check:rc==0
cmd:rpower $$CN reset
check:rc==0
check:output=~$$CN: reset
cmd:rpower $$CN stat
check:rc==0
check:output=~$$CN: on
cmd:rpower $$CN off
check:rc==0
cmd:rpower $$CN reset
check:rc==0
check:output=~$$CN: off
cmd:rpower $$CN stat
check:rc==0
check:output=~$$CN: off
cmd:rpower $$CN on
check:rc==0
end

start:redfish_rsetboot_net_hd
description:rsetboot net and rsetboot hd through a Redfish BMC; rsetboot stat confirms each boot device
