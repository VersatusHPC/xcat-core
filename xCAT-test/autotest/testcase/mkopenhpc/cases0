start:mkopenhpc_slurm_hierarchy
description:mkopenhpc deploys Slurm with slurmctld on the MN and slurmd on a CN behind a service node, and srun runs a job on that CN
os:Linux
label:openhpc
cmd:rm -f /tmp/mkopenhpc_slurm_hierarchy.ready
cmd:mkopenhpc -r $$OHPC_REPO -p $$SLURM_PARTITION $$CN && touch /tmp/mkopenhpc_slurm_hierarchy.ready
check:rc==0
# xcattest keeps running commands after a failed check. The steps below need what mkopenhpc
# deploys, so each one starts only when mkopenhpc succeeded.
cmd:test -f /tmp/mkopenhpc_slurm_hierarchy.ready && systemctl is-active munge slurmctld
check:rc==0
# The CN gets munge.key and slurm.conf from the SN through its synclist and postscripts, so it is
# provisioned again behind the SN.
cmd:test -f /tmp/mkopenhpc_slurm_hierarchy.ready && /opt/xcat/share/xcat/tools/autotest/testcase/commoncmd/retry_install.sh $$CN __GETNODEATTR($$CN,os)__-__GETNODEATTR($$CN,arch)__-install-compute 1
check:rc==0
check:output=~Provision node\(s\)\: $$CN
cmd:test -f /tmp/mkopenhpc_slurm_hierarchy.ready && xdsh $$CN "systemctl is-active munge slurmd"
check:rc==0
cmd:test -f /tmp/mkopenhpc_slurm_hierarchy.ready && xdsh $$SN "systemctl is-active slurmd"
check:rc!=0
# srun waits for a node with no limit. Start it only on an idle node, and with a time limit.
cmd:test -f /tmp/mkopenhpc_slurm_hierarchy.ready && /opt/xcat/share/xcat/tools/autotest/testcase/commoncmd/slurm_job.sh wait_idle $$CN || { rm -f /tmp/mkopenhpc_slurm_hierarchy.ready; false; }
check:rc==0
check:output=~^idle$
cmd:test -f /tmp/mkopenhpc_slurm_hierarchy.ready && /opt/xcat/share/xcat/tools/autotest/testcase/commoncmd/slurm_job.sh run_job $$SLURM_PARTITION
check:rc==0
check:output=~^$$CN
cmd:rm -f /tmp/mkopenhpc_slurm_hierarchy.ready
end

start:mkopenhpc_slurm_fips_cn
description:Slurm runs a job on a CN in FIPS mode. It runs after fips_node_enabled, which installs the CN again with fips=1; confignodeslurm stays in the CN postbootscripts from mkopenhpc_slurm_hierarchy, so the reinstall sets up munge and slurmd. No extra install
os:Linux
label:openhpc,fips
cmd:state=`xdsh $$CN cat /proc/sys/crypto/fips_enabled | awk '{print $2}'`;echo "fips_enabled on $$CN: $state";[ "$state" = 1 ]
check:rc==0
cmd:xdsh $$CN "systemctl is-active munge slurmd"
check:rc==0
cmd:rm -f /tmp/mkopenhpc_slurm_fips_cn.idle; /opt/xcat/share/xcat/tools/autotest/testcase/commoncmd/slurm_job.sh wait_idle $$CN && touch /tmp/mkopenhpc_slurm_fips_cn.idle
check:rc==0
check:output=~^idle$
cmd:test -f /tmp/mkopenhpc_slurm_fips_cn.idle && /opt/xcat/share/xcat/tools/autotest/testcase/commoncmd/slurm_job.sh run_job $$SLURM_PARTITION
check:rc==0
check:output=~^$$CN
cmd:rm -f /tmp/mkopenhpc_slurm_fips_cn.idle
end
