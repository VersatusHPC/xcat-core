start:confignetwork_roce_rxe
description:confignetwork configures a RoCE nic from the nics table: its IP, a soft-RoCE (rdma_rxe) link on it, and RoCE v2 as the default GID type. rping and ib_send_bw then run between the CN and the MN over that link.
label:others,network,roce
cmd:lsdef $$CN;if [ $? -eq 0 ]; then lsdef -l $$CN -z >/tmp/CN.roce.stanza ;fi
check:rc==0
cmd:dnf -y install rdma-core librdmacm-utils perftest
check:rc==0
cmd:xdsh $$CN "dnf -y --nogpgcheck --disablerepo='*' --enablerepo='local-*' install rdma-core librdmacm-utils perftest"
check:rc==0
cmd:xdsh $$CN -e /opt/xcat/share/xcat/tools/autotest/testcase/commoncmd/nic_cfg.sh backup
check:rc==0
cmd:mkdef -t network -o xcatci_roce net=198.18.0.0 mask=255.255.255.0 mgtifname=$$SECONDNIC
check:rc==0
cmd:chdef $$CN nicips.$$SECONDNIC=198.18.0.10 nictypes.$$SECONDNIC=RoCE nicnetworks.$$SECONDNIC=xcatci_roce
check:rc==0
cmd:updatenode $$CN -P confignetwork
check:rc==0
cmd:xdsh $$CN "ip -4 -o addr show dev $$SECONDNIC"
check:rc==0
check:output=~198.18.0.10/24
cmd:xdsh $$CN "rdma link show"
check:rc==0
check:output=~state ACTIVE physical_state LINK_UP netdev $$SECONDNIC
cmd:xdsh $$CN "for d in /sys/class/infiniband/*; do c=/sys/kernel/config/rdma_cm/\$(basename \$d); mkdir -p \$c && cat \$c/ports/1/default_roce_mode; rmdir \$c; done"
check:rc==0
check:output=~RoCE v2
cmd:/opt/xcat/share/xcat/tools/autotest/testcase/confignetwork/roce_peer.sh up __GETNODEATTR($$CN,ip)__ 198.18.0.1/24
check:rc==0
cmd:/opt/xcat/share/xcat/tools/autotest/testcase/confignetwork/roce_peer.sh serve rping 198.18.0.1
check:rc==0
cmd:xdsh $$CN "rping -c -a 198.18.0.1 -C 10 -v"
check:rc==0
check:output=~ping data: rdma-ping-9
cmd:/opt/xcat/share/xcat/tools/autotest/testcase/confignetwork/roce_peer.sh serve ib_send_bw 198.18.0.1
check:rc==0
cmd:xdsh $$CN "ib_send_bw -R -n 1000 198.18.0.1"
check:rc==0
check:output=~65536\s+1000\s+\d
cmd:/opt/xcat/share/xcat/tools/autotest/testcase/confignetwork/roce_peer.sh down __GETNODEATTR($$CN,ip)__ 198.18.0.1/24
check:rc==0
cmd:xdsh $$CN "for l in \$(rdma link show | sed -n 's/^link \([^/]*\)\/.* netdev $$SECONDNIC\$/\1/p'); do rdma link delete \$l; done"
cmd:xdsh $$CN "ip addr del 198.18.0.10/24 dev $$SECONDNIC"
cmd:xdsh $$CN -e /opt/xcat/share/xcat/tools/autotest/testcase/commoncmd/nic_cfg.sh del $$SECONDNIC
cmd:xdsh $$CN -e /opt/xcat/share/xcat/tools/autotest/testcase/commoncmd/nic_cfg.sh restore
cmd:rmdef -t network -o xcatci_roce
cmd:if [ -e /tmp/CN.roce.stanza ]; then rmdef $$CN; cat /tmp/CN.roce.stanza | mkdef -z; rm -f /tmp/CN.roce.stanza; fi
check:rc==0
end
