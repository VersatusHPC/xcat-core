start:reg_freebsd_ipv6_dualstack_flat
description:The confignetwork postscript gives a FreeBSD compute node a static IPv6 address beside its IPv4 address at install
os:Linux
label:flat_cn_diskful,provision,freebsd,ipv6
# Runs after reg_freebsd_diskfull_installation_flat, which writes the disk policy and the image.
# The case installs the node again with confignetwork selected. updatenode -P is not used: on
# xcat-mfsbsd-1 media it needs site.freebsdimportpolicy, which this cell does not configure.
# The provision network is L2 isolated per cluster, so fd00:402::/64 is the same in every cluster.
cmd:lsdef -t osimage -s | awk '/^freebsd15\.1-x86_64-install-compute/ {print $1}' > /tmp/xcattest.freebsd6.osimage; test "$(wc -l < /tmp/xcattest.freebsd6.osimage)" -eq 1
check:rc==0
cmd:mn=$(ip -o -4 addr show | awk -v gw="$$GATEWAY" '$4 ~ "^" gw "/" {print $2}'); test -n "$mn" && echo "$mn" > /tmp/xcattest.freebsd6.mnnic
check:rc==0
cmd:ip -6 addr replace fd00:402::1/64 dev $(cat /tmp/xcattest.freebsd6.mnnic) nodad
check:rc==0
cmd:g=$$GATEWAY; lsdef -t network -i net -c | awk -F': ' -v n="net=${g%.*}.0" '$2 == n {print $1}' > /tmp/xcattest.freebsd6.net4; test "$(wc -l < /tmp/xcattest.freebsd6.net4)" -eq 1
check:rc==0
cmd:mkdef -t network -o freebsd_ipv6_dualstack net=fd00:402::/64 mask=/64
check:rc==0
# e1000 is em0 on FreeBSD. The conf gives the node one e1000 NIC.
cmd:ip4=$(lsdef $$CN -i ip -c | awk -F= '{print $2}'); chdef $$CN nictypes.em0=Ethernet "nicips.em0=$ip4|fd00:402::10" "nicnetworks.em0=$(cat /tmp/xcattest.freebsd6.net4)|freebsd_ipv6_dualstack"
check:rc==0
cmd:chdef $$CN -p postscripts=confignetwork
check:rc==0
cmd:nodeset $$CN osimage=$(cat /tmp/xcattest.freebsd6.osimage)
check:rc==0
# The node reports booted again only after the new install. Clear the old status first.
cmd:chdef $$CN status=
check:rc==0
cmd:rpower $$CN reset
check:rc==0
cmd:a=0; while [ $a -lt 120 ]; do s=$(lsdef $$CN -i status -c | awk -F= '{print $2}'); echo "$(date +%T) $s"; [ "$s" = booted ] && exit 0; a=$((a+1)); sleep 30; done; exit 1
check:rc==0
cmd:xdsh $$CN ifconfig em0
check:rc==0
check:output=~inet6 fd00:402::10 prefixlen 64
check:output=~inet 192\.168\.
cmd:ping -6 -c 3 fd00:402::10
check:rc==0
cmd:xdsh $$CN ping6 -c 3 fd00:402::1
check:rc==0
cmd:ssh -6 -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@fd00:402::10 freebsd-version
check:rc==0
check:output=~15\.1-RELEASE
cmd:ping -c 3 $$CN
check:rc==0
cmd:chdef $$CN -m postscripts=confignetwork
cmd:chdef $$CN nictypes.em0= nicips.em0= nicnetworks.em0=
cmd:rmdef -t network -o freebsd_ipv6_dualstack
cmd:ip -6 addr del fd00:402::1/64 dev $(cat /tmp/xcattest.freebsd6.mnnic)
cmd:rm -f /tmp/xcattest.freebsd6.osimage /tmp/xcattest.freebsd6.mnnic /tmp/xcattest.freebsd6.net4
end
